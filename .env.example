# Copy this file to .env (or .env.local) and fill in the language model the app should use.
# Any server with an OpenAI-compatible API works: Google Gemini, OpenAI, Mistral, OpenRouter, Ollama, LM Studio...

# Base URL of the OpenAI-compatible API.
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenAI:        https://api.openai.com/v1
#   Ollama:        http://localhost:11434/v1
LLM_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# API key for that server. For Gemini, create one at https://aistudio.google.com/app/apikey
# A local server like Ollama does not need one: leave it empty.
LLM_API_KEY="your_api_key_here"

# Model that writes the answers.
LLM_MODEL="gemini-3.5-flash-lite"

# Optional: model that builds the concept graph (one call per passage). Defaults to LLM_MODEL,
# except with Gemini's gemini-3.5-flash-lite, where it defaults to gemini-3-flash-preview (flash-lite extracts too little).
# LLM_GRAPH_MODEL="gemini-3-flash-preview"

# Optional: price in USD per million tokens, to show the cost of each answer in Details.
# Known for gemini-3.5-flash-lite; 0 for any other model unless set here.
# LLM_PRICE_INPUT="0.30"
# LLM_PRICE_OUTPUT="2.50"
